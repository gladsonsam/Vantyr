$ORIGIN lab.vantyr.test.
$TTL 300

; The SOA record TTL and its minimum field are both 60s: the stub's negative
; answers therefore carry a deterministic 60s TTL (RFC 2308).
@   60 IN SOA ns.lab.vantyr.test. hostmaster.lab.vantyr.test. (
        1       ; serial
        3600    ; refresh
        600     ; retry
        604800  ; expire
        60 )    ; negative TTL

@           IN  NS    ns.lab.vantyr.test.
ns          IN  A     172.26.9.53

; Addresses use documentation ranges only (RFC 5737 and RFC 3849).
www     300 IN  A     203.0.113.10
www     300 IN  AAAA  2001:db8::10
alias    90 IN  CNAME www.lab.vantyr.test.
ttl     123 IN  A     198.51.100.7

; Sinkhole-shaped answer retained from the upstream-only smoke fixture.
sink     60 IN  A     192.0.2.0

; Contrast records for the opt-in Vantyr filtering smoke. The base assertions
; (www / alias / ttl / missing) are deliberately untouched. Direct stub
; queries return these answers; the Vantyr worker must return its own policy
; denial instead, which proves the answer came from Vantyr and not this stub.
blocked    60 IN  A     198.51.100.99
ads.tracker 60 IN A     198.51.100.98
forwardalias 60 IN CNAME blocked.lab.vantyr.test.
