# Vantyr DNS lab integration contract (informational only).
#
# The `vantyr-dns` worker is a real binary and does NOT read these values from
# the environment. Its validated configuration is the JSON fixture at
# configs/vantyr.lab.json, loaded with `vantyr-dns --config <FILE>`. The values
# below describe the socket contract that fixture implements; see README.md.
#
# Worker listener (bind address/port, with explicit non-loopback opt-in):
VANTYR_DNS_LISTEN_HOST=172.26.9.55
VANTYR_DNS_LISTEN_PORT=15353
VANTYR_DNS_ALLOW_NON_LOOPBACK=true

# Container-side upstream (the deterministic stub on the private labnet):
VANTYR_DNS_UPSTREAM_HOST=172.26.9.53
VANTYR_DNS_UPSTREAM_PORT=15353

# Host-side upstream via compose.host-access.yml only (loopback, never host
# DNS/DHCP/router/firewall configuration):
VANTYR_DNS_UPSTREAM_LOOPBACK_HOST=127.0.0.1
VANTYR_DNS_UPSTREAM_LOOPBACK_PORT=15553

# Optional host-side worker exposure via compose.vantyr-host-access.yml only:
VANTYR_DNS_HOST_PUBLISH_LOOPBACK_PORT=15554
