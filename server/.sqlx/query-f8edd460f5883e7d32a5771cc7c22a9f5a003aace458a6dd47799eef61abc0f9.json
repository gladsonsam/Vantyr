{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, ts, actor, client_ip, agent_id, action, status, detail\n        FROM audit_log\n        WHERE ($1::uuid IS NULL OR agent_id = $1)\n          AND ($2::text IS NULL OR action = $2)\n          AND ($3::text IS NULL OR status = $3)\n        ORDER BY ts DESC\n        LIMIT $4 OFFSET $5\n        ",
