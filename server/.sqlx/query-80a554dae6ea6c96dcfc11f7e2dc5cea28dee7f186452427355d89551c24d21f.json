  "query": "\n        SELECT u.id AS user_id, u.username, u.role, u.display_name, u.display_icon, s.csrf_token\n        FROM dashboard_sessions s\n        JOIN dashboard_users u ON u.id = s.user_id\n        WHERE s.token_sha256_hex = $1\n          AND s.expires_at > NOW()\n        ",
