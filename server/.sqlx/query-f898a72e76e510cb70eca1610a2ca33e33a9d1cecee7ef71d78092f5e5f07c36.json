{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id, s.agent_id, s.connected_at, s.disconnected_at,\n            a.name as agent_name\n        FROM agent_sessions s\n        JOIN agents a ON a.id = s.agent_id\n        ORDER BY s.connected_at DESC\n        LIMIT $1\n        ",
