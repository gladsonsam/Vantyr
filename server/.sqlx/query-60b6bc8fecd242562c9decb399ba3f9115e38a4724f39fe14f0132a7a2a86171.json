{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            e.script_id, e.agent_id, e.status, e.expected_fire_time, e.output,\n            e.is_manual,\n            a.name as agent_name\n        FROM scheduled_script_executions e\n        JOIN agents a ON a.id = e.agent_id\n        WHERE e.script_id = $1\n        ORDER BY e.expected_fire_time DESC\n        LIMIT $2\n        ",
