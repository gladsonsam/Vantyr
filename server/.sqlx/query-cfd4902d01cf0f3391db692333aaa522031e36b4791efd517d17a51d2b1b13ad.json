  "query": "\n        SELECT e.category_id, c.key\n        FROM url_category_url_entries e\n        JOIN url_categories c ON c.id = e.category_id\n        WHERE c.enabled = true\n          AND $1 LIKE (e.url_prefix || '%')\n        LIMIT 1\n        ",
